# Local AI Gateway 环境变量

# API 鉴权
API_KEY=local-ai-gateway-secret-key

# 网关端口
HOST=0.0.0.0
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
# Ollama 模型路由
# 文本对话模型（"qwen" 请求会路由到它）
OLLAMA_TEXT_MODEL=qwen3.5:9b
# 支持视觉的 Ollama 模型（"qwen-vl" 请求会路由到它）
OLLAMA_VL_MODEL=qwen3.5:9b

# SDCPP
SDCPP_URL=http://127.0.0.1:8080

# Kokoro TTS
KOKORO_URL=http://127.0.0.1:8880

# ASR
ASR_URL=http://127.0.0.1:8881

# Video Worker
VIDEO_WORKER_URL=http://127.0.0.1:8001

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# 模型目录
MODEL_DIR=./.models